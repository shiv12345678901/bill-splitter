# Port for local web server
PORT=3000
HOST=127.0.0.1

# Google Gemini API Key (Free tier from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Local WhatsApp session storage directory
SESSION_DATA_PATH=./.wwebjs_auth

# InstaBox worker. Keep this key server-only; never put it in the frontend.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Safe default: schema verification only. Set to live only after the SQL
# migration and schema/business-rule review are complete.
SUPABASE_WORKER_MODE=dry-run
SUPABASE_WORKER_SCHEMA_APPROVED=
SUPABASE_WORKER_WRITE_CONFIRM=
# Required in live mode; see config/worker-contract.example.json.
SPLITMATE_CONTRACT_FILE=
SPLITMATE_RUNTIME_DIR=./data/run
SPLITMATE_SUPABASE_POLL_MS=5000
SPLITMATE_SYNC_REQUESTED_BY=netlify-app
SPLITMATE_SYNC_LEASE_SECONDS=900
SPLITMATE_WORKER_ID=
# Existing settlements can be refreshed. For first insertion confirm the ID
# type and select text or uuid; both use deterministic IDs for retries.
SUPABASE_SETTLEMENT_ID_MODE=existing-only
# Falls back to user_config.json when omitted.
SPLITMATE_WHATSAPP_GROUP_ID=
SPLITMATE_WHATSAPP_GROUP_NAME=
SPLITMATE_WHATSAPP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.8078.73 Safari/537.36
