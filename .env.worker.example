# Copy to .env.worker on the VM; chmod 600. No frontend credentials here.
SUPABASE_WORKER_MODE=dry-run
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy JWT fallback; leave unset when using SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
SPLITMATE_GEMINI_REQUEST_TIMEOUT_MS=30000
SPLITMATE_WHATSAPP_GROUP_ID=
SPLITMATE_WHATSAPP_GROUP_NAME=
# Supported whatsapp-web.js Client userAgent override; update when Chromium major changes.
SPLITMATE_WHATSAPP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.8078.73 Safari/537.36
SPLITMATE_SUPABASE_POLL_MS=5000
SPLITMATE_SYNC_LEASE_SECONDS=900
SPLITMATE_SYNC_REQUESTED_BY=netlify-app
# Generate a different owner identity on every process start; normally leave empty.
SPLITMATE_WORKER_ID=
SUPABASE_WORKER_SCHEMA_APPROVED=
SUPABASE_WORKER_WRITE_CONFIRM=
# Compose sets these paths automatically. Absolute paths for running without Docker.
SESSION_DATA_PATH=/state/whatsapp
SPLITMATE_DATA_DIR=/state/data
SPLITMATE_RUNTIME_DIR=/state/run
SPLITMATE_CONTRACT_FILE=/run/secrets/worker_contract
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
TZ=Australia/Sydney
